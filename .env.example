# Copy this file to .env. Never commit .env or paste secrets into public/index.html.

# Required for live Recall mode. Leave blank for simulated mode.
RECALL_API_KEY=

# Must match the region where the API key was created.
# Valid examples: us-east-1, us-west-2, eu-central-1, ap-northeast-1
RECALL_REGION=us-east-1

# The workspace verification secret from the Recall webhooks dashboard.
# Required for authenticating POST /hooks/recall.
RECALL_WEBHOOK_SECRET=

# Local server settings.
PORT=3000

# Optional. Defaults to ./data/flightdeck.json.
FLIGHTDECK_DATA_DIR=./data

# Optional. Used only to sign simulated webhook deliveries.
FLIGHTDECK_DEMO_SECRET=whsec_flightdeck_demo
